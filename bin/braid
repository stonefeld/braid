#!/usr/bin/env bash
# The one entry point. Lives on your PATH, not in your repository.
#
# Every command runs from the worktree you are standing in and works out the rest —
# which repository, which feature branch, which workers — from git and the filesystem.
# Nothing here reads a file braid wrote down about where you are.

set -uo pipefail

# Where the engine is. The dispatcher is normally a symlink in ~/.local/bin, so the
# link has to be resolved before anything next to it can be found. BRAID_HOME wins, for
# running a working copy without installing it.
resolve_home() {
    local target="${BASH_SOURCE[0]}" dir
    while [[ -L "$target" ]]; do
        dir=$(cd -P "$(dirname "$target")" && pwd)
        target=$(readlink "$target")
        [[ "$target" != /* ]] && target="$dir/$target"
    done
    cd -P "$(dirname "$target")/.." && pwd
}

BRAID_HOME="${BRAID_HOME:-$(resolve_home)}"
export BRAID_HOME
[[ -d "$BRAID_HOME/lib" ]] || {
    echo "error: no braid engine at $BRAID_HOME — reinstall, or set BRAID_HOME" >&2
    exit 1
}

# command:blurb. The dispatcher is the only place that knows the full surface, so this
# table is also what `braid help` prints and what an unknown command is measured
# against. A command is here once lib/<name>.sh exists.
# section:name:blurb. The dispatcher is the only place that knows the full surface, so
# this table is also what `braid help` prints and what an unknown command is measured
# against. A command is here once lib/<name>.sh exists.
#
# Sectioned by who types it. A first screen that mixes the four commands a person runs
# with the seven the orchestrator's seat runs answers a question nobody asked — and the
# third heading describes rather than forbids: `braid status` is something you read all
# day.
#
# `hook` is deliberately absent. A settings.json invokes it, no person does, and it was
# taking a line on the first screen anybody sees.
COMMANDS=(
    "Preparing a repository:init:scaffold this repository, then learn what it is"
    "Preparing a repository:learn:open the session that works out what this repository is"
    "Preparing a repository:config:read and write what this repository and this machine decided"
    "Preparing a repository:doctor:check this machine can run a wave"
    "You run these:next:what to run now, and why"
    "You run these:design:open the design seat, at the right tier"
    "You run these:plan:derive a feature's wave schedule from its slices"
    "You run these:orchestrate:open the orchestrator seat on this feature"
    "The orchestrator seat runs these:wave:launch a wave, at most BRAID_MAX_WORKERS at a time"
    "The orchestrator seat runs these:spawn:launch a worker on one slice, in its own worktree"
    "The orchestrator seat runs these:status:what every worker is doing"
    "The orchestrator seat runs these:wait:block until this wave settles"
    "The orchestrator seat runs these:verify:run the project's mechanical gate"
    "The orchestrator seat runs these:integrate:rebase a worker onto the feature branch and fast-forward"
    "The orchestrator seat runs these:reap:tear a worker down once its commits have landed, or the whole feature"
    "The engine:upgrade:update the engine, keeping what you changed"
    "The engine:version:print the engine version"
    "The engine:help:print this"
    ":hook:run an agent hook (registered in .claude/settings.json)"
)

usage() {
    local entry name blurb
    cat >&2 <<'TXT'
braid — run coding agents in parallel, then weave their work into one branch

usage: braid <command> [options]
TXT
    local section last=""
    for entry in "${COMMANDS[@]}"; do
        section="${entry%%:*}"
        name="${entry#*:}"
        blurb="${name#*:}"
        name="${name%%:*}"
        [[ -n "$section" ]] || continue
        [[ "$section" == "$last" ]] || printf '\n  %s\n' "$section" >&2
        last="$section"
        printf '    %-12s %s\n' "$name" "$blurb" >&2
    done
    cat >&2 <<'TXT'

  BRAID_HOME  run an uninstalled working copy
TXT
}

command="${1:-}"
[[ $# -gt 0 ]] && shift

case "$command" in
    version)
        cat "$BRAID_HOME/VERSION" 2>/dev/null || echo unknown
        ;;
    "" | -h | --help | help)
        usage
        ;;
    *)
        # A command in the table with no file behind it means a broken install, not a
        # typo, and saying so saves reading shell to find out.
        for entry in "${COMMANDS[@]}"; do
            entry="${entry#*:}"
            if [[ "$command" == "${entry%%:*}" ]]; then
                [[ "$command" == wait || -f "$BRAID_HOME/lib/$command.sh" ]] ||
                    {
                        echo "error: braid $command is missing from $BRAID_HOME/lib — reinstall" >&2
                        exit 1
                    }
                # wait is status with a flag: one implementation, so the states a
                # loop waits on cannot drift from the states it prints.
                [[ "$command" == wait ]] && exec bash "$BRAID_HOME/lib/status.sh" --wait "$@"
                exec bash "$BRAID_HOME/lib/$command.sh" "$@"
            fi
        done
        echo "error: unknown command '$command'" >&2
        echo >&2
        usage
        exit 1
        ;;
esac
